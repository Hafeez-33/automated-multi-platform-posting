# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="Automated Multi-Platform Posting System"
APP_ENV="development"
PORT=4000
HOST="0.0.0.0"

# ==============================================================================
# 1. Telegram Configuration (Bot API)
# ==============================================================================
# Create a bot via @BotFather and add it as an administrator to your public channel.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="@your_public_channel_username"

# ==============================================================================
# 2. Discord Configuration (Webhooks API)
# ==============================================================================
# Create a Webhook in Discord: Channel Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"

# ==============================================================================
# 3. Reddit Configuration (OAuth2 Data API)
# ==============================================================================
# Register an app at https://www.reddit.com/prefs/apps.
# Use OAuth2 flow with refresh token or pre-generated bearer access token.
# Plaintext Reddit user passwords are NOT required.
REDDIT_CLIENT_ID="your_reddit_client_id"
REDDIT_CLIENT_SECRET="your_reddit_client_secret"
REDDIT_REFRESH_TOKEN="your_reddit_refresh_token"
REDDIT_ACCESS_TOKEN=""
REDDIT_USER_AGENT="AutomatedPoster/1.0.0"
REDDIT_SUBREDDIT="test"

# ==============================================================================
# 4. LinkedIn Configuration (REST Posts API)
# ==============================================================================
# Generate an OAuth2 token on the LinkedIn Developer Portal with w_member_social scope.
# Specify active supported YYYYMM version (e.g., 202611).
LINKEDIN_ACCESS_TOKEN="your_linkedin_access_token"
LINKEDIN_AUTHOR_URN="urn:li:person:your_person_id"
LINKEDIN_VERSION="202611"

# ==============================================================================
# 5. Mastodon Configuration (Fediverse Status API)
# ==============================================================================
# Register on any Mastodon instance (e.g., https://mastodon.social).
# Preferences -> Development -> New Application -> copy Access Token (scope: write:statuses).
MASTODON_INSTANCE_URL="https://mastodon.social"
MASTODON_ACCESS_TOKEN="your_mastodon_access_token"
